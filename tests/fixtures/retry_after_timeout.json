{
  "name": "retry after timeout",
  "startEpoch": 0,
  "accounts": [
    {
      "id": "maker-e",
      "balances": [{ "asset": "dUSD", "available": 300000 }]
    },
    {
      "id": "merchant-e",
      "balances": [{ "asset": "dUSD", "available": 0 }]
    },
    {
      "id": "lane-ops",
      "balances": [{ "asset": "dUSD", "available": 0 }]
    }
  ],
  "lanes": [
    {
      "id": "usd-timeout",
      "asset": "dUSD",
      "operator": "lane-ops",
      "policy": {
        "timeoutEpochs": 3,
        "feeBps": 10,
        "maxRetries": 2,
        "minPacketAmount": 1000,
        "maxPacketAmount": 500000
      }
    }
  ],
  "actions": [
    {
      "type": "submit",
      "epoch": 1,
      "packet": {
        "id": "pkt-retry-1",
