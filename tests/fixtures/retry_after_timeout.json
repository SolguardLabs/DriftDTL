        "source": "maker-e",
        "recipient": "merchant-e",
        "amount": 100000,
        "priority": "high"
      }
    },
    { "type": "cancel", "epoch": 4, "packet": "pkt-retry-1" },
    {
      "type": "retry",
      "epoch": 5,
      "packet": {
        "id": "pkt-retry-1",
        "lane": "usd-timeout",
        "source": "maker-e",
        "recipient": "merchant-e",
        "amount": 100000,
        "priority": "high"
      }
    },
    { "type": "confirm", "epoch": 6, "packet": "pkt-retry-1", "ack": "ack-retry-1" }
  ]
