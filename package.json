{
  "name": "driftdtl",
  "version": "1.0.0",
  "private": true,
  "description": "Motor determinista de liquidación asíncrona con núcleo C++20 y SDK TypeScript.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build -- --warnings && npm run test:ts",
    "test:ts": "node --import tsx --test \"tests/node/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "ci": "node scripts/ci.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:artifacts": "node scripts/verify-artifacts.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
