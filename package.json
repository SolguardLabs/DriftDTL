{
  "name": "driftdtl",
  "version": "0.1.0",
  "private": true,
  "description": "Motor C++ de settlement asincronico con fixtures TypeScript.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build -- --warnings && npm run test:ts",
    "test:ts": "node --import tsx --test \"tests/node/*.test.ts\"",
    "ci": "node scripts/ci.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
